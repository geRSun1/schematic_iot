    <mxGraphModel dx="1374" dy="749" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\nparticipant \&quot;DHT11 Sensor\&quot; as DHT\nparticipant \&quot;ESP32 Node\&quot; as ESP\nparticipant \&quot;MQTT Broker\&quot; as MQTT\nparticipant \&quot;Application Service\&quot; as APP\ndatabase \&quot;Measurement Repository\&quot; as DB\nparticipant \&quot;Web Dashboard\&quot; as UI\n\nDHT -&gt; ESP : read()\n\nalt Read Success\n\n    ESP -&gt; ESP : buildTelemetry()\n\n    alt MQTT Available\n\n        ESP -&gt; MQTT : publish(telemetry)\n\n        note right\n        topic:\n        nhom01/node01/telemetry\n        end note\n\n        MQTT -&gt; APP : telemetry(payload)\n\n        APP -&gt; APP : validatePayload()\n\n        alt Payload Valid\n\n            APP -&gt; DB : saveMeasurement()\n\n            DB --&gt; APP : measurementId\n\n            APP -&gt; APP : checkThreshold()\n\n            alt Threshold Exceeded\n\n                APP -&gt; APP : createAlert()\n\n            else Normal\n\n                APP -&gt; APP : noAction()\n\n            end\n\n        else Payload Invalid\n\n            APP -&gt; DB : saveRejectedPayload()\n\n        end\n\n    else MQTT Unavailable\n\n        ESP -&gt; ESP : bufferTelemetry()\n\n    end\n\nelse Read Failed\n\n    ESP -&gt; MQTT : publish(sensor_error)\n\nend\n\nUI -&gt; APP : getLatest(node01)\n\nAPP -&gt; DB : findLatest(node01)\n\nDB --&gt; APP : measurement\n\nAPP -&gt; APP : calculateFreshness()\n\nalt Fresh\n\n    APP --&gt; UI : measurement + fresh\n\nelse Stale\n\n    APP --&gt; UI : measurement + stale\n\nelse Empty\n\n    APP --&gt; UI : no data\n\nend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6c8eYa6B3n9PBFcwFPEk-1">
